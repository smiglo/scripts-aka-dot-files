#!/usr/bin/env bash
# vim: fdl=0

# Is installed # {{{
${RCSTUFF_RUNTIME_POST_INSTALLED:-false} && [[ $1 != '--force' ]] && return 0
[[ $1 == '--force' ]] && shift
export RCSTUFF_RUNTIME_POST_INSTALLED=true
# }}}
# Runtime file # {{{
RUNTIME_POST_FILE=$RUNTIME_PATH/runtime-post.bash
for rpost in $($BASH_PATH/env-ext.sh get-plugins runtime-post.bash); do
  source $rpost
done
unset RUNTIME_POST_FILE rpost
# }}}
# TMUX_STATUS_RIGHT_EXTRA # {{{
if [[ -z $TMUX_STATUS_RIGHT_EXTRA_SORTED ]]; then
  TMUX_STATUS_RIGHT_EXTRA_SORTED=
  ( ${TMUX_STATUS_RIGHT_EXTRA_HAS_BATTERY:-false} || [[ -n $TMUX_SB_BATTERY_THRESHOLDS ]] ) && TMUX_STATUS_RIGHT_EXTRA+=" 016:battery"
  while read l; do
    l=$(echo ${l#*:})
    [[ -z $l ]] && continue
    export TMUX_STATUS_RIGHT_EXTRA_SORTED+="$l "
  done < <(echo -e "$TMUX_STATUS_RIGHT_EXTRA" | tr ' ' '\n' | command grep -v '^#' | sort -ut ':' -k2,2 | sort -nt ':' -k1,1)
  unset l TMUX_STATUS_RIGHT_EXTRA
fi # }}}
if ! is-installed --no-cache -t kp-pp; then # {{{
  source "$SCRIPT_PATH/inits/keep-pass/keep-pass-env.sh"
fi # }}}
# Check personalities # {{{
[[ -n $PERS_USERS ]] || export PERS_USERS="tom"
# }}}
# nvm # {{{
if [[ -e $HOME/.nvm ]] && ${NODE_USE_NVM:-false}; then
  export NVM_DIR="$HOME/.nvm"
  [[ -s $NVM_DIR/nvm.sh ]] && source $NVM_DIR/nvm.sh
  [[ -s $NVM_DIR/bash_completion ]] && source $NVM_DIR/bash_completion
fi # }}}
# Unicode extra chars # {{{
if [[ ! -z "$UNICODE_EXTRA_CHARS_FILE" && ! -e "$UNICODE_EXTRA_CHARS_FILE" ]]; then
  touch "$UNICODE_EXTRA_CHARS_FILE"
  {
    echo "declare -Ag UNICODE_EXTRA_CHARS"
    for i in $(echo ${!UNICODE_EXTRA_CHARS[*]} | tr ' ' '\n' | sort); do
      echo "UNICODE_EXTRA_CHARS[$i]=\"${UNICODE_EXTRA_CHARS[$i]}\""
    done
  } >"$UNICODE_EXTRA_CHARS_FILE"
  unset i
fi # }}}
# fzf override # {{{
if $FZF_INSTALLED && [[ -n $PS1 ]]; then # {{{
  eval "$(fzf --bash)"
  __fzf_handler_git() { # {{{
    mode=$1; shift
    case $mode in
    init)
      cmdList=(
        [1.branch]="git branch | cut -c3- | sort"
        [2.log]="git log --graph --oneline --decorate --color -15000  --format='%C(240)|%C(172)%h%C(240)|%C(reset)%C(auto)%d %C(dim white)%s%C(reset)' --exclude=refs/remotes/* --exclude=refs/tags/* --decorate-refs-exclude=refs/tags/tmp/sync/* --branches --remotes"
        [3.branch-all]="git branch --all | cut -c3- | sed -e '/\/HEAD ->/d' -e 's|remotes/||' | sort"
      )
      fzfParams="--preview-window nohidden";;
    loop) ;;
    expect) ;;
    result) # {{{
      case $cmdKey in
      2.log)
        cat - | while read -r item; do
          [[ "$item" =~ .*\|([0-9a-f]{5,})\|.* ]] || continue
          printf "%s\n" "${BASH_REMATCH[1]}"
        done;;
      *)
        cat -;;
      esac;; # }}}
    preview) # {{{
      local line="$1"
      case $cmdKey in
      2.log)
        [[ "$line" =~ .*\|([0-9a-f]{5,})\|.* ]] || return
        local sha=${BASH_REMATCH[1]}
        git log --pretty=fuller --date=local -1 "$sha"
        echo; echo '    ----'
        git diff $sha~..$sha --name-status | sed -e 's/^/    /'
        echo '    ----'; echo
        git diff -w $sha~..$sha \
        | if which colordiff >/dev/null 2>&1; then colordiff -u; else cat -; fi;;
      *)
        git log -1 -n50 --graph --color $line;;
      esac;; # }}}
    esac
  } # }}}
  __fzf_handler_fs() { # {{{
    local mode=$1; shift
    local key_upper="ctrl-u" key_home="ctrl-h" key_into="ctrl-e" key_orig="ctrl-o"
    case $mode in
    init) # {{{
      p="$PWD"; origPath="$PWD"
      expectList="--expect $key_upper --expect $key_home --expect $key_into --expect $key_orig";; # }}}
    loop) # {{{
      command cd "$p"
      prompt="> "
      [[ $PWD != $origPath ]] && prompt="${PWD/$HOME/\~}> ";; # }}}
    expect) # {{{
      local key=$1
      case $key in
      $key_upper) p="$(cd ..; pwd)";;
      $key_home)  p="$HOME";;
      $key_orig)  p="$origPath";;
      $key_into)
        p="$(echo "$list" | sed -n '2p')"
        $dirMode || p="$(dirname "$p")"
        p="$PWD/$p";;
      esac;; # }}}
    result) # {{{
      cat - | while read -r item; do
        printf '%q\n' "$PWD/$item"
      done \
      | sed -e 's|'"$PWD/"'||';; # }}}
    preview) # {{{
      local f="$1"
      [[ -e $f || ( -h $f && -f $(readlink -f $f) ) ]] || return
      cat.sh -p $f;; # }}}
    esac
  } # }}}
  __fzf_select__() { # {{{
    local dirMode=false
    FZF_DEFAULT_COMMAND="${FZF_CTRL_T_COMMAND:-} | sed 's|^\./||'"
    local optsDef="--reverse ${FZF_CTRL_T_OPTS-}" opts="-m --ansi" optsWalker="--walker=file,dir,follow,hidden --scheme=path"
    local handler="__fzf_handler_fs"
    while [[ ! -z $1 ]]; do # {{{
      case $1 in
      --cmd) # {{{
        FZF_DEFAULT_COMMAND="$2"; shift
        handler="";; # }}}
      --dir) # {{{
        dirMode=true
        optsWalker="--walker=dir,follow,hidden --scheme=path"
        FZF_DEFAULT_COMMAND="${FZF_ALT_C_COMMAND:-} | sed 's|^\./||'"
        optsDef="${FZF_ALT_C_OPTS-}";; # }}}
      --opts-walker) # {{{
        optsWalker="$2"; shift;; # }}}
      --opts) # {{{
        opts="$s"; shift;; # }}}
      --handler) # {{{
        handler="$2"; shift;; # }}}
      *) break;;
      esac; shift
    done # }}}
    FZF_DEFAULT_OPTS=$(__fzf_defaults "$optsWalker" "$optsDef $opts")
    fzf-chooser() { # {{{
      local expectList= prompt= list=() keys=() key_nextCmd="ctrl-n" fzfParams=
      declare -Ag cmdList=()
      export cmdKey=
      local -i cmdI=-1
      $handler init
      if (( ${#cmdList[@]} )); then
        cmdI=0
        expectList+=" --expect $key_nextCmd"
        keys=( $(printf "%s\n" "${!cmdList[@]}" | sort -n) )
      fi
      export -f $handler
      while true; do
        prompt=
        if (( cmdI >= 0 )); then
          cmdKey="${keys[cmdI]}"
          FZF_DEFAULT_COMMAND="${cmdList[$cmdKey]}"
          prompt="$((cmdI+1))/${#keys[@]}.${cmdKey#*.}> "
        fi
        $handler loop
        readarray -t list < <(FZF_DEFAULT_OPTS_FILE='' fzf \
          --highlight-line \
          --bind=alt-r:toggle-raw \
          --prompt "$prompt" \
          --preview "$handler preview {}" \
          $expectList $fzfParams "$@")
        [[ -z $expectList || -z ${list[0]} ]] && break
        if (( cmdI >= 0 )) && [[ ${list[0]} == $key_nextCmd ]]; then
          cmdI=(cmdI+1)%${#keys[@]}
        else
          $handler expect ${list[0]}
        fi
      done
      unset list[0]
      (( ${#list[@]} )) || return
      printf "%s\n" "$cmdKey"
      printf "%s\n" "${list[@]}"
    } # }}}
    local res=()
    readarray -t res < <(fzf-chooser)
    (( ${#res[@]} )) || return
    local cmdKey=${res[0]};  unset res[0]
    printf "%s\n" "${res[@]}" | $handler result | tr '\n' ' '
  } # }}}
  __fzf-file-widget() { # {{{
    local selected="$(__fzf_select__ "$@")"
    [[ -n $selected ]] || return 0
    READLINE_LINE="${READLINE_LINE:0:$READLINE_POINT}$selected${READLINE_LINE:$READLINE_POINT}"
    READLINE_POINT=$(( READLINE_POINT + ${#selected} ))
  } # }}}
  __fzf-dir-widget() { # {{{
    local selected="$(__fzf_select__ --dir "$@")"
    [[ -n $selected ]] || return 0
    READLINE_LINE="${READLINE_LINE:0:$READLINE_POINT}$selected${READLINE_LINE:$READLINE_POINT}"
    READLINE_POINT=$(( READLINE_POINT + ${#selected} ))
  } # }}}
  __fzf-cd-widget() { # {{{
    __fzf-dir-widget "$@"
  } # }}}
  __fzf-git-widget() { # {{{
    local selected="$(
      __fzf_select__ --handler "__fzf_handler_git")"
    [[ -n $selected ]] || return 0
    READLINE_LINE="${READLINE_LINE:0:$READLINE_POINT}$selected${READLINE_LINE:$READLINE_POINT}"
    READLINE_POINT=$(( READLINE_POINT + ${#selected} ))
  } # }}}
  __fzf-history() { # {{{
    [[ -s $HISTFILE ]] || return 0
    local histEntry="$(
      set +o pipefail; history -r;
      tac "$HISTFILE" \
      | awk '!($0 in a) {a[$0]; print}' \
      | fzf --ansi --scheme=history --bind=ctrl-r:toggle-sort,alt-r:toggle-raw --highlight-line --query "$READLINE_LINE")"
    [[ -n $histEntry ]] || return
    READLINE_LINE="$histEntry"
    READLINE_POINT=${#READLINE_LINE}
  } # }}}
  __fzf-env-widget() { # {{{
    declare -a resA
    readarray -t resA < <(\
      compgen -v | grep "^[A-Z]" \
      | fzf +m --sort \
          --prompt 'env> ' \
          --preview 'eval echo \${1}' --preview-window 'nohidden' \
          --expect ctrl-n \
          --expect ctrl-q \
          --expect ctrl-v)
    (( $? == 0 )) || return 1
    local key="${resA[0]}" selected="${resA[1]}"
    [[ -n $selected ]] || return 1
    case $key in
    '') selected="\$$selected";;
    ctrl-n) ;;
    ctrl-q) local -n ref="$selected"; selected="\"$ref\"";;
    ctrl-v) local -n ref="$selected"; selected="$ref";;
    esac
    READLINE_LINE="${READLINE_LINE:0:$READLINE_POINT}$selected${READLINE_LINE:$READLINE_POINT}"
    READLINE_POINT=$((READLINE_POINT + ${#selected}))
  } # }}}
  __fzf-inserter-widget() { # {{{
    declare input=() output=()
    local i= query=
    for i in $(remove-dups --sep ' ' "$FZF_INSERTER_FILES") $APPS_CFG_PATH/fzf-inserter $(find-up.sh ./.fzf-inserter); do
      [[ -e $i ]] || continue
      mapfile -t -O ${#input[@]} input <$i
    done
    [[ -n $FZF_INSERTER_V ]] && mapfile -t -O ${#input[@]} input < <(echo -e "$FZF_INSERTER_V")
    (( ${#input[@]} )) || return
    local toRemove=() j= k=
    for i in ${!input[@]}; do
      [[ -n ${input[i]} ]] || continue
      [[ ${input[i]} == '# -'* ]] || continue
      local k="${input[i]#\# -}"
      toRemove[i]=
      for j in ${!input[@]}; do
        [[ "${input[j]}" =~ $k ]] && toRemove[j]=
      done
    done
    (( ${#toRemove[@]} )) && unset $(printf "input[%d] " ${!toRemove[@]})
    if [[ ! $READLINE_LINE =~ ' '$ ]]; then
      query="${READLINE_LINE##* }"
      found=false
      for i in "${input[@]}"; do
        i=${i#*:: }
        [[ $i == $query* ]] && found=true && break
      done
      if $found; then
        READLINE_LINE="${READLINE_LINE%$query}"
      else
        query=
      fi
    fi
    mapfile -t output < <(set -o pipefail;
      printf "%s\n" "${input[@]}" \
      | sed -e '/^\s*$/d' -e '/^#/d' \
      | sort -u \
      | sed -e '/.*:: .*/s/\(.*::\) \(.*\)/'"$CGray"'\1'"$COff"' \2/' \
      | fzf -m --ansi --query "$query")
    (( ${#output[@]} )) || return
    local toAdd=$(printf "%s " "${output[@]#*:: }")
    toAdd="${toAdd% }"
    READLINE_LINE="${READLINE_LINE:0:READLINE_POINT}$toAdd${READLINE_LINE:READLINE_POINT}"
    READLINE_POINT=$(( READLINE_POINT + ${#toAdd} ))
  } # }}}
  __fzf-tab-completer() { # {{{
    local complDef= complFun= selections=

    declare -ax COMP_WORDS=( $READLINE_LINE)
    declare -x COMP_CWORD=${#COMP_WORDS[@]}
    local cmd=${COMP_WORDS[0]}
    [[ -n $cmd ]] || return 0

    complDef=$(complete -p "$cmd" 2>/dev/null)
    [[ -z $complDef ]] && complDef=$(complete -p "$(compgen -c -- "$cmd")" 2>/dev/null)
    [[ -n $complDef ]] || return

    [[ $complDef =~ \ -F\ ([^[:space:]]+) ]] || return
    complFun="${BASH_REMATCH[1]}"
    [[ "$(type -t "$complFun")" == "function" ]] || return

    declare -x COMP_LINE="${COMP_WORDS[@]}"
    declare -x COMP_POINT=${#COMP_LINE}
    [[ ${COMP_WORDS[-1]} == -* && $READLINE_LINE != *' ' ]] && (( COMP_CWORD-=1 ))
    COMPREPLY=()
    $complFun "${COMP_WORDS[@]}"
    (( ${#COMPREPLY[@]} > 0 )) || return

    selections=$(printf "%s\n" "${COMPREPLY[@]}" | fzf --multi | xargs)
    [[ -n "$selections" ]] || return
    [[ ${COMP_WORDS[-1]} =~ ^(-+)* && $READLINE_LINE != *' ' ]] && selections=${selections#${BASH_REMATCH[1]}}
    [[ $selections == */ ]] || selections="$selections "

    READLINE_LINE="${READLINE_LINE:0:READLINE_POINT}${selections}${READLINE_LINE:READLINE_POINT}"
    READLINE_POINT=$(( READLINE_POINT + ${#selections} ))
  } # }}}
  bind -m vi-command -r "\C-r"
  bind -m vi-insert  -r "\C-r"
  bind -m vi-command -x '"\C-w\C-e": "__fzf-env-widget"'
  bind -m vi-insert  -x '"\C-w\C-e": "__fzf-env-widget"'
  bind -m vi-command -x '"\C-w\C-g": "__fzf-git-widget"'
  bind -m vi-insert  -x '"\C-w\C-g": "__fzf-git-widget"'
  bind -m vi-command -x '"\C-w\C-i": "__fzf-inserter-widget"'
  bind -m vi-insert  -x '"\C-w\C-i": "__fzf-inserter-widget"'
  bind -m vi-command -x '"\C-w\C-r": "__fzf-history"'
  bind -m vi-insert  -x '"\C-w\C-r": "__fzf-history"'
  bind -m vi-insert  -x '"\C-w\C-t": "__fzf-tab-completer"'
  bind -m vi-command -x '"\C-r": "__fzf-history"'
  bind -m vi-insert  -x '"\C-r": "__fzf-history"'
  bind -m vi-command -x '"\C-t": "__fzf-file-widget"'
  bind -m vi-insert  -x '"\C-t": "__fzf-file-widget"'
  bind -m vi-insert  -x '"\C-y": "__fzf-tab-completer"'
  bind -m vi-insert     '"\ec": "\C-gcd\C-m"'
  bind -m vi-command -x '"\ed": "__fzf-cd-widget"'
  bind -m vi-insert  -x '"\ed": "__fzf-cd-widget"'
  bind -m vi-insert  -x '"\e\t": "__fzf-tab-completer"' # alt-tab
fi # }}}
# }}}
if $IS_DOCKER; then # {{{
  if ! $IS_VSCODE && $BASHRC_FULL_START; then # {{{
    $ENV_SCRIPTS/docker-tools/clipboard-docker.sh &
    disown $!
  fi # }}}
fi # }}}
if $IS_VSCODE; then # {{{
  set-utils -h "$APPS_CFG_PATH/vscode" +basic +hist +remember-conf-dir=.remb +note-file=notes.txt
fi # }}}
unset -f set-utils
