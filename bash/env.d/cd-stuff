#!/usr/bin/env bash
# vim: fdl=0

__cd_util() { # {{{
  case $1 in
  --stored-load) # {{{
    declare -Ag CD_DIRS=()
    local f=
    for f in $CD_DIRS_F; do
      [[ -e $f ]] || continue
      source "$f"
    done;; # }}}
  --stored-edit) # {{{
    vim $CD_DIRS_F;; # }}}
  --list-parents) # {{{
    shift
    local cDir="${1:-$PWD}"
    local stdout= i=1
    while [[ -n $cDir ]]; do
      cDir=${cDir%/*}
      [[ -n $cDir ]] || cDir="/"
      [[ -e $cDir ]] || continue
      stdout+="$(printf "%d. %s" "$i" "${cDir/$HOME/\~}")\n"
      ((++i))
      [[ $cDir == "/" ]] && break
    done
    echo -e "$stdout";; # }}}
  --tilde-conv) # {{{
    shift
    local d="$1"
    [[ $d == '~'* ]] && d="${d/\~/$HOME}"
    echo "$d";; # }}}
  --update-dst) # {{{
    shift
    local key="$(echo -e "$1" | sed -n '1p')"
    local dst="$(echo -e "$1" | sed -n '2p')"
    if [[ -z $2 ]]; then
      dst="${dst##*. }"
    elif [[ "$2" == eval\ * ]]; then
      dst="$($2)"
    else
      dst="$(eval echo "$2")"
    fi
    echo -en "$key\n$dst";; # }}}
  --prompt) # {{{
    local dst=$2 prompt=
    [[ $dst == $HOME ]] && prompt="~" || prompt="$(basename $dst)"
    echo "$prompt";; # }}}
  esac
} # }}}
__cd_util_mode_parent() { # {{{
  $use_fzf || return 0
  local dst=
  case $1 in
  .[0-9]*) # {{{
    if [[ ! -e "$1" ]]; then
      dst="$(__cd_util --list-parents | sed -n ${1:1}p)"
      dst="${dst##*. }"
      [[ ! -z $2 ]] && dst+="/$2" && shift
    else
      dst="$1"
    fi;; # }}}
  .) # {{{
    if [[ -z $2 ]]; then
      stdout="$(__cd_util --list-parents)"
      dst="$(echo -e "$stdout" | fzf $fzf_common_params --prompt='Parent> ')" || return 0
      dst="$(__cd_util --update-dst "$dst")"
    else
      dst="../$2" && shift
    fi;; # }}}
  esac
  echo "$dst"
} # }}}
__cd_util_mode_previous() { # {{{
  $use_fzf || return 0
  local dst= len=${#CD_LAST_DIRS[@]}
  (( len > 1 )) || return 0
  case $1 in
  ,[0-9]*) # {{{
    local i=${1#,}
    (( i < len )) || return 1
    dst="${CD_LAST_DIRS[i]}"
    [[ -e $dst ]] || return 1
    [[ -n $2 && -e $dst/$2 ]] && dst+="/$2";; # }}}
  ,) # {{{
    if [[ -z $2 ]]; then
      stdout=$(for ((cnt=1, i=0; i<len; ++i)); do
        [[ ${CD_LAST_DIRS[i]} == $PWD ]] && continue
        [[ ! -e ${CD_LAST_DIRS[i]} ]] && continue
        printf "%d. %s\n" $cnt "$(echo ${CD_LAST_DIRS[i]} | sed "s|^$HOME|~|")"
        ((cnt+=1))
      done)
      dst="$(echo -e "$stdout" | fzf $fzf_common_params --prompt='Last> ')" || return 0
      dst="$(__cd_util --update-dst "$dst")"
      [[ -z $dst ]] && return 1
    else
      dst="${CD_LAST_DIRS[1]}"
      [[ -e $dst/$2 ]] && dst+="/$2"
      shift
    fi;; # }}}
  esac
  echo "$dst"
} # }}}
__cd_util_mode_stored() { # {{{
  $use_fzf || return 0
  local dst= stdout=
  __cd_util --stored-load
  case $1 in
  :) # {{{
    stdout=$(ii=0; for key in $(echo "${!CD_DIRS[@]}" | tr ' ' '\n' | sort -f); do
      p="${CD_DIRS[$key]}"
      [[ -n $p && -e $p ]] || continue
      ((ii+=1)) && printf "%2d. %12s: %s\n" "$ii" "${key:0:12}" "$(echo -e "$p" | sed "s|^$HOME|~|")"
    done)
    dst="$(echo -e "$stdout" | fzf $fzf_common_params  --prompt='Stored> ')" || return 0
    dst="$(__cd_util --update-dst "$dst" '${dst#*: }')";; # }}}
  :*) # {{{
    dst="${CD_DIRS[${1:1}]}"
    [[ -n $dst && -e $dst ]] || return 1
    [[ ! -z $2 ]] && dst+="/$2" && shift;; # }}}
  esac
  echo "$dst"
} # }}}
__cd_util_mode_interactive() { # {{{
  # Env configutation # {{{
  local fzf_params="${CD_INTERACTIVE_FZF_PARAMS:--e -x}"
  local md="-"
  local loop="${CD_INTERACTIVE_LOOP:-true}"
  local add_parent_dirs="${CD_INTERACTIVE_PARENT:-true}"
  local add_predefined="${CD_INTERACTIVE_PREDEFINED:-true}"
  local add_stored="${CD_INTERACTIVE_STORED:-true}"
  local add_last_dirs="${CD_INTERACTIVE_LAST_DIR:-true}"
  local dst="."
  # }}}
  if [[ $1 == '-i' ]]; then
    md=$2; shift 2
  elif [[ $1 == -[0-9]* ]]; then
    md="${1#-}"; shift
  fi
  local res= list= prompt= cd_list= tmp= k= v= predefined_list= user_list= query= first=true
  while [[ ! -z $1 ]]; do # {{{
    case $1 in
    -i)                 md="$2"; shift;;
    --no-first)         first=false;;
    --fzf-params)       fzf_params="$2"; shift;;
    --last)             add_last_dirs=true;;
    -l   | --loop)      loop=true;;
    --parent)           add_parent_dirs=true;;
    --no-last)          add_last_dirs=false;;
    --no-loop)          loop=false;;
    --no-parent)        add_parent_dirs=false;;
    --predefined)       add_predefined=true;;
    --no-predefined)    add_predefined=false;;
    --stored)           add_stored=true;;
    --no-stored)        add_stored=false;;
    *)                  query="$1";;
    esac
    shift
  done # }}}
  case $md in # {{{
  -)
    md="${CD_INTERACTIVE_DEPTH:-3}"
    if [[ $PWD == $HOME/* ]]; then
      local dirLvl="${PWD//[^\/]/}"
      local dirLvl=${#dirLvl}
      (( dirLvl >= 4 )) && md=$((md + dirLvl-3))
    fi
    md="$(awk -v md=$md 'BEGIN {print int(md * 1.5)}')";;
  -*)
    md=${md#-}
    md="$(awk -v md=$md 'BEGIN {print int(md * 1.5)}')";;
  esac # }}}
  if $add_stored; then # {{{
    __cd_util --stored-load
    for k in $(echo "${!CD_DIRS[@]}" | tr ' ' '\n' | sort -f); do
      v="${CD_DIRS[$k]}"
      [[ -e $v ]] || continue
      [[ ! -d "$(__cd_util --tilde-conv "$v")" ]] && continue
      cd_list+="$(printf ":%-6s --> %s" "$k" "${v/$HOME/\~}")\n"
    done
  fi # }}}
  if $add_predefined; then # {{{
    tmp=
    while IFS= read -r -d ':' i; do
      k="${i%%@*}" v="${i#*@}"
      [[ -z $k || -z $v ]] && continue
      [[ -d "$(__cd_util --tilde-conv "$v")" ]] || continue
      tmp+="$(printf "@%-6s --> %s" "$k" "${v/$HOME/~}")\n"
    done <<< "HOME@$HOME:ROOT@/:${CD_INTERACTIVE_PREDEFINED_LIST%:}:"
    predefined_list="$(echo -e "$tmp" | sort -f -k1,1 | sed -e '/^$/d')"
  fi # }}}
  fzf_wrapper() { # {{{
    local mode="$1" wd="$3" dir=
    [[ $2 == '---' || -z $2 ]] && dir="$wd"
    [[ -z $dir ]] && dir="$(echo -e "$2" | awk '/ --> / {$1=$2=""; print $0; next}; {print $0}')"
    dir="$(echo $(__cd_util --tilde-conv "$dir"))"
    [[ $dir != /* ]] && dir="$wd/$dir" && dir="$(command cd "$dir"; pwd)"
    splitParam() { # {{{
      if [[ $TMUX_VERSION -ge 34 ]]; then
        echo "-l $1%"
      else
        echo "-p $1"
      fi
    } # }}}
    local fzf_key_step_in='ctrl-d'
    local fzf_key_show_hidden='ctrl-f' fzf_key_upper="ctrl-u" fzf_key_into="ctrl-e" fzf_key_orig="ctrl-o" fzf_key_refresh="ctrl-r" fzf_key_last="ctrl-l"
    case $mode in
    prev)
      printf "C +%c: %-10s +%c: %-10s +%c: %-10s\n" "${fzf_key_step_in#ctrl-}"  "in&cont" "${fzf_key_upper#ctrl-}"  "up"    "${fzf_key_show_hidden#ctrl-}"  "hidden"
      printf "  +%c: %-10s +%c: %-10s +%c: %-10s\n" "${fzf_key_refresh#ctrl-}"  "refresh" "${fzf_key_last#ctrl-}"   "last"  "${fzf_key_orig#ctrl-}"         "orig"
      printf "  +%c: %-10s\n"                       "${fzf_key_into#ctrl-}"     "goto"
      echo
      fzf-exe -c prev --prev 10 -f "$dir";;
    split-v) [[ -n $TMUX ]] && tmux split-window -v $(splitParam 30) -d -c "$dir";;
    split-h) [[ -n $TMUX ]] && tmux split-window -h $(splitParam 50) -d -c "$dir";;
    new-wnd) [[ -n $TMUX ]] && tmux new-window   -a -d -c "$dir" -n "${dir##*/}";;
    esac
  } # }}}
  export -f fzf_wrapper __cd_util
  local empty=false hidden=false
  local fzf_key_show_hidden='ctrl-f' fzf_key_upper="ctrl-u" fzf_key_into="ctrl-e" fzf_key_orig="ctrl-o" fzf_key_refresh="ctrl-r" fzf_key_last="ctrl-l"
  local orgDst="$PWD" lastDst=
  local exclude_list="$CD_INTERACTIVE_EXCLUDE_LIST node_modules .venv* build tmp .cache" exclude="$CD_INTERACTIVE_EXCLUDE"
  if $IS_MAC || $IS_DOCKER; then # {{{
    exclude_list+=" Applications Library"
  fi # }}}
  if $IS_VIRTUAL_OS; then # {{{
    exclude_list+=" host"
  fi # }}}
  for i in $exclude_list; do
    exclude+=" -E '$i/*' -E '**/$i/*'"
  done
  while true; do # {{{
    dst="$(command cd "$(__cd_util --tilde-conv "$dst")"; pwd)"
    # List # {{{
    list=
    empty=false
    $loop && ! $first && list="---\n"
    if (( $md > 0 )); then # {{{
      local depth=$md
      case $dst in
      / | /mnt | /mount | /home | /proc | /sys | /Users ) depth=1;;
      $HOME/Library) depth=2;;
      /usr | /proc | /sys) depth=3;;
      *)
        local dirLvl="${dst//[^\/]/}"
        (( ${#dirLvl} == 1 )) && depth=1;;
      esac
      res="$( \
        command cd $dst
        fd -Ld $depth $exclude $($hidden && echo "--hidden") --type d 2>/dev/null \
        | awk -F'/' '{print NF-1, $0}' \
        | sed -e 's|/$||' \
        | sort -s -k1,1n -k2,2f \
        | cut -d' ' -f2-)"
      [[ ! -z $res ]] && list+="$res\n" || empty=true
    fi # }}}
    if $add_parent_dirs && [[ "$dst" != '/' ]]; then # {{{
      list+="\n"
      list+="../\n"
      list+="$( \
        command cd $dst
        fd -Ld 1 $($hidden && echo "--hidden") --type d '.*' ..  2>/dev/null \
        | sed -e 's|/$||' \
        | sort -f)\n"
      local i=0 pdir= tmp=
      while read tmp pdir; do
        i=$((i+1))
        list+="...${i}/  --> $pdir\n"
      done < <(__cd_util --list-parents "$dst")
      local dd="${dst%/*}" ddAdd="../.."
      while [[ $dd == $HOME/* ]]; do
        cnt="${ddAdd//[.]}"
        cnt=$((${#cnt}+1))
        list+="$( \
          command cd $dst
          fd -Ld 1 $($hidden && echo "--hidden") --type d '.*' "$(realpath "$ddAdd")" 2>/dev/null \
          | sed -e 's|/$||' -e 's|'$HOME'|~|' \
          | sort -f \
          | sed -e 's|^.*/\(.*\)|...'$cnt'/\1 --> \0|')\n"
        ddAdd+="/.."
        dd=${dd%/*}
      done
    fi # }}}
    list+='\n'
    if $add_last_dirs; then # {{{
      [[ ! -z $lastDst ]] && list+="@last   --> $lastDst\n"
      list+="@orig   --> $orgDst\n"
      [[ ! -z $OLDPWD && -e $OLDPWD ]] && list+="@oldpwd --> $OLDPWD\n"
      for ((i=1; i<${#CD_LAST_DIRS[@]}; ++i)); do
        list+=",$i      --> ${CD_LAST_DIRS[$i]}\n"
      done
      list+='\n'
    fi # }}}
    if [[ -z $query ]]; then # {{{
      if $add_user_list && [[ ! -z "$user_list" ]]; then # {{{
        list+="$user_list\n"
      fi # }}}
      if [[ ! -z "$predefined_list" ]]; then # {{{
        $add_predefined && list+="$predefined_list\n"
      fi # }}}
      if [[ ! -z "$cd_list" ]]; then # {{{
        $add_stored && list+="$cd_list\n"
      fi # }}}
    fi # }}}
    # }}}
    # Prompt # {{{
    prompt="$(__cd_util --prompt "$dst")"
    stdout="$(echo -e "$list" | sed -e '/^\.\{1,2\}$/d')" # -e 's|[^ ]/$||')"
    # }}}
    res=
    if [[ ! -z $query && $query == *,* ]]; then # {{{
      n=${query##*,}
      [[ -z $n ]] && n=1
      query="${query%,*}"
      case $n in
      -) stdout="$(echo -e "$stdout" | grep -F "$query")"; query=;;
      *)
        res="$(echo -e "$stdout" | grep -F "$query" | grep "$query$" | sed -n ${n}p)"
        if [[ ! -z $res ]]; then
          dst="$(__cd_util --tilde-conv "$res")"
          break
        fi;;
      esac
    fi # }}}
    # fzf-list # {{{
    declare -a resA
    readarray -t resA < <( \
      echo -e "$stdout" \
      | fzf \
          $fzf_common_params --no-sort \
          --expect $fzf_key_show_hidden \
          --expect $fzf_key_upper \
          --expect $fzf_key_into \
          --expect $fzf_key_orig \
          --expect $fzf_key_last \
          --expect $fzf_key_refresh \
          --layout=reverse \
          --preview "fzf_wrapper prev {} \"$dst\"" \
          --bind "ctrl-v:execute(fzf_wrapper split-v {} \"$dst\")" \
          --bind "ctrl-h:execute(fzf_wrapper split-h {} \"$dst\")" \
          --bind "ctrl-n:execute(fzf_wrapper new-wnd {} \"$dst\")" \
          --prompt="$prompt> " \
          $fzf_params \
          --query="$query" --print-query \
    ) || return 0
    first=false
    local userQuery="${resA[0]}" key="${resA[1]}"
    res="${resA[@]:2}"
    # }}}
    query=
    case $key in # {{{
    $fzf_key_upper) # {{{
      [[ $dst != / ]] && lastDst="$dst" && dst="$(command cd "$dst/.." && pwd)"
      continue;; # }}}
    $fzf_key_last) # {{{
       local ld="$dst"
       [[ ! -z $lastDst ]] && dst="$lastDst" && lastDst="$ld"
       continue;; # }}}
    $fzf_key_into) ;;
    $fzf_key_orig) # {{{
      lastDst="$dst"
      dst="$orgDst"
      continue;; # }}}
    $fzf_key_step_in) ;;
    $fzf_key_show_hidden) # {{{
      $hidden && hidden=false || hidden=true
      query="$userQuery"
      continue;; # }}}
    $fzf_key_refresh) # {{{
      query="$userQuery"
      continue;; # }}}
    '') # {{{
      loop=false;; # }}}
    esac # }}}
    [[ ! -z $res ]] || return 0
    [[ $res =~ ^.*\ +'-->'\ +(.*) ]] && res="${BASH_REMATCH[1]}"
    res="$(__cd_util --tilde-conv "$res")"
    lastDst="$dst"
    case $res in # {{{
    ---)  break;;
    *) # {{{
      if [[ $res == /* ]]; then
        dst="$res"
      else
        dst="$(command cd $dst/$res && pwd)"
      fi
      [[ ! -d "$dst" ]] && return 1
      ;; # }}}
    esac # }}}
    ! $loop && break
  done # }}}
  dst="$(__cd_util --tilde-conv "$dst")"
  [[ -z $dst || ! -d $dst ]] && return 1
  echo "$dst"
} # }}}
cd_wrapper() { # @@ # {{{
  if [[ $1 != '@@' && $1 != '--' && $1 != '-f' ]]; then # {{{
    if [[ ${#BASH_SOURCE[*]} -gt 1 ]]; then
      command cd "$@"
      return $?
    fi
  else
    [[ $1 == '--' ]] && shift
    if [[ $1 != '@@' && $1 != '-f' && "${#BASH_SOURCE[*]}" != 2 ]]; then
      echoe false "Fall-back [${#BASH_SOURCE[*]}], [$@]"
      command cd "$@"; return $?;
    fi
    [[ $1 == '-f' ]] && shift
  fi # }}}
  local dst="$1" oldPWD="$PWD" i= cmd="cd" p= verbose=false len= out= stdout= create_dir=false param= in_pipe=false step_in=false err=0
  if [[ $1 == '@@' ]]; then # {{{
    __cd_util --stored-load
    # echoe -e "\na=[$@]\n"
    if [[ $3 == '-i' || $4 == '-i' ]]; then # {{{
      echo "2 3 4 5 10 --fzf-params"
      ${CD_INTERACTIVE_LOOP:-true}         && echo "--no-loop"       || echo "--loop"
      ${CD_INTERACTIVE_PARENT:-true}       && echo "--no-parent"     || echo "--parent"
      ${CD_INTERACTIVE_PREDEFINED:-true}   && echo "--no-predefined" || echo "--predefined"
      ${CD_INTERACTIVE_STORED:-true}       && echo "--no-stored"     || echo "--stored"
      return 0 # }}}
    elif [[ $4 == ':' && $2 -ge 3 ]]; then # {{{
      for i in ${!CD_DIRS[@]}; do
        if [[ "$i" == $5 ]]; then
          echo "$(command cd "${CD_DIRS[$i]}/$6" && fd -Ld 2 --type d)" 2>/dev/null | sed -e 's|^\./||' -e '/^\.$/d'
        fi
      done
      return 0 # }}}
    elif [[ $4 == ','* && $2 -ge 2 ]]; then # {{{
      i=${4#,}
      [[ -n $i ]] || i=1
      (( i < ${#CD_LAST_DIRS[@]} )) || return
      echo "$(command cd "${CD_LAST_DIRS[i]}" && fd -Ld2 --type d)" 2>/dev/null | sed -e 's|^\./||' -e '/^\.$/d'
      return 0 # }}}
    elif [[ $4 == '.'* && $2 -ge 2 ]]; then # {{{
      i="${4:1}"
      [[ -z $i ]] && i="1"
      dst="$(eval printf "../%.0s" {1..$i})"
      echo "$(command cd "$dst" && fd -Ld2 --type d)" 2>/dev/null | sed -e 's|^\./||' -e '/^\.$/d'
      return 0
    fi # }}}
    local ret=''
    for i in ${!CD_DIRS[@]}; do
      ret+=" :$i"
    done
    ret+=" $($BASH_PATH/env-ext.sh call --all __util_cd_param @@ | tr ' ' '\n' | sed 's/^/:/')"
    ret+=" @@-d -mk -P -pu -po -i --no-pipe --old-pwd --stored-edit"
    echo "$ret"
    return 0
  fi # }}}
  [[ ! -t 1 ]] && in_pipe=true
  local colors= COff=
  if [[ ! -e "$dst" ]]; then
    case $dst in
    *?,*) set -- -i -8 --loop --stored-none --fzf-params "-e -x --query=" "$@";;
    esac
  fi
  if [[ ! -e "$dst" || $1 == '.' || $1 == '--' ]]; then # {{{
    dst=
    [[ $1 == '--' ]] && shift
    eval $FZF_USAGE
    local use_fzf=${fzfUsageA[cd]:-$FZF_INSTALLED}
    local fzf_key_step_in='ctrl-d'
    local fzf_common_params="--exit-0 --select-1 --expect $fzf_key_step_in --sort --no-multi"
    if [[ -z $1 ]]; then
      if [[ -e $PWD ]]; then
        set -- -i
      else
        dst="$(__cd_util --list-parents | sed -n 1p)"
        dst="${dst##*. }"
      fi
    fi
    # Switches first # {{{
    while [[ ! -z $1 ]]; do
      case $1 in
      --stored-edit)
        __cd_util --stored-edit
        return;;
      --old-pwd) oldPWD="$2"; shift;;
      --)  dst="$2"; shift $#; break;;
      -mk) create_dir=true;;
      -pu) cmd="pushd";;
      -po) cmd="popd";;
      -v)  verbose=true; in_pipe=true; use_fzf=false;;
      --no-pipe) in_pipe=false;;
      -P)  dst="$(readlink -f "${2:-$PWD}")"; shift $#; break;;
      -i | -[0-9]* | -) break;;
      -*)  [[ ! -d "$1" ]] && cmd+=" $1" || { dst="$1"; shift $#; break; };;
      *)   break;;
      esac; shift
    done # }}}
    if ! $in_pipe; then # {{{
      colors=("[48;5;12m" "${COnBlack}")
      COff='[0m'
    fi # }}}
    while [[ ! -z $1 ]]; do # {{{
      case $1 in
      . | .[0-9]*) # Parents # {{{
        dst="$(__cd_util_mode_parent "$@")"
        break;; # }}}
      ,*) # Previous # {{{
        dst="$(__cd_util_mode_previous "$@")"
        break;; # }}}
      :*) # Stored # {{{
        dst="$(__cd_util_mode_stored "$@")"
        break;; # }}}
      -i | -[0-9]*) # Interactive # {{{
        shift
        if [[ -z "$dst" && "$@" =~ "--query="\ *.+$ ]]; then
          local dstConv=$(__cd_util --tilde-conv "${@: -1}")
          [[ $dstConv == '-' ]] && dstConv=$OLDPWD
          [[ -d "$dstConv" || ( -h "$dstConv" && -d "$(readlink -f "$dstConv")" ) ]] && dst="$dstConv"
        fi
        [[ -z "$dst" ]] && dst="$(__cd_util_mode_interactive "$@")"
        break;; # }}}
      *) # {{{
        dst="$1"
        break;; # }}}
      esac; shift
    done # }}}
    if ! $in_pipe && [[ "$(echo -e "$dst" | wc -l)" -gt 1 ]]; then # {{{
      step_in=false
      local key="$(echo -e "$dst" | sed -n '1p')"
      dst="$(echo -e "$dst" | sed -n '2p')"
      case $key in
      $fzf_key_step_in) step_in=true;;
      esac
    fi # }}}
    if [[ $dst == env:* ]]; then # {{{
      local env="${dst%;*}"
      dst="${dst##*;}"
      eval "${env#env:}"
    fi # }}}
    [[ -z $dst ]] && return 0
  fi # }}}
  dst="$(__cd_util --tilde-conv "$dst")"
  if $in_pipe; then
    command cd "$dst"
    return 0
  fi
  cmd="$cmd ${dst// /\\ }"
  [[ "$dst" == '-' && -z $OLDPWD ]] && eval $(die "OLDPWD not set")
  if $verbose && [[ $cmd == cd* ]]; then # {{{
    if [[ ! -e "$dst" && "$dst" != '-' && ! -z "$dst" ]]; then
      $create_dir && command mkdir -p $dst || return 1
    fi
    (eval command $cmd >/dev/null 2>&1; pwd)
    return 0
  fi # }}}
  [[ $cmd == pushd* || $cmd == popd* ]] && cmd="$cmd >/dev/null"
  # Update the list of last dirs # {{{
  if ! $step_in && [[ $cmd == cd* || $cmd == pushd* ]] && [[ "$dst" != "$oldPWD" ]]; then
    [[ ! -e "$dst" && "$dst" != '-' && ! -z "$dst" ]] && $create_dir && command mkdir -p "$dst"
    if [[ -e "$dst" || "$dst" == '-' || -z "$dst" ]]; then # {{{
      local dst_path="$([[ "$dst" == '-' ]] && dst="$oldPWD"; command cd "$dst" 2>/dev/null; pwd)"
      local max_to_store=${CD_LAST_MAX:-8}
      [[ -z $CD_LAST_DIRS ]] && CD_LAST_DIRS=( "$oldPWD" )
      for ((i=0; i<${#CD_LAST_DIRS[@]}; ++i)); do
        [[ ${CD_LAST_DIRS[i]} == "$dst_path" ]] && unset CD_LAST_DIRS[i]
      done
      export CD_LAST_DIRS=( "$dst_path" "${CD_LAST_DIRS[@]:0:$((max_to_store-1))}" )
    fi # }}}
  fi # }}}
  eval command $cmd
  err=$?
  if [[ $err == 0 ]]; then
    if $step_in; then
      cd_wrapper -- -f -- --old-pwd "$oldPWD" -i 3 --no-first
      err=$?
    fi
    OLDPWD="$oldPWD"
  fi
  return $err
} # }}}
cd_no_expansion() { # @@ { # {{{
  set +f
  cd_wrapper -- "$@"
} # }}}
__cdd_completion() { # {{{
  local cur= opts= depth=4
  cur=${COMP_WORDS[COMP_CWORD]}
  _get_comp_words_by_ref -n : cur
  local dirLvl="${PWD//[^\/]/}"
  if (( ${#dirLvl} >= 5 )); then depth=8
  elif [[ $PWD == $HOME/* ]]; then depth=4
  else depth=3
  fi
  opts="$(fd -d $depth --type d -L --no-ignore-vcs 2>/dev/null | sed -e '/\/$/s|/$||' -e '/.\+\/.\+/s|$|,|' | sed -e 's|.*/||' | sort -u)"
  COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
  __ltrim_colon_completions "$cur"
} # }}}
complete $COMPLETE_DEFAULT_PARAMS -F __cdd_completion cdd
compl-add --old cd

alias cd='set -f; cd_no_expansion' # @@
alias cdd='cd -i -8 --loop --stored --predefined --fzf-params "-e -x --query="'
alias ccd='builtin cd'
alias cdp='cd -P'
alias po='cd -po'
alias pu='cd -pu'
alias .1='cd .1'
alias .2='cd .2'
alias .3='cd .3'
alias .4='cd .4'
alias .5='cd .5'
alias  recd='command cd && command cd - >/dev/null 2>&1'
export HISTIGNORE+=":recd"
