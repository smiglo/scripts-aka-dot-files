#!/usr/bin/env bash
# vim: fdl=0

scriptPath="$SCRIPT_PATH/bin/awk.script"
if [[ $1 == '@@' ]]; then # {{{
  case $3 in
  split) echo ": -";;
  -f) get-file-list '*.awk'; get-file-list --pwd "$scriptPath" '*.awk';;
  -F) echo "\'[=\\ ]\'";;
  *)
    echo "1 2 3"
    echo "-F -f -v"
    echo "/REG/"
    echo "split";;
  esac
  exit 0
fi # }}}
params= print= pre= script= verbose=false
while [[ ! -z $1 ]]; do # {{{
  case $1 in
  -v) verbose=true;;
  split)
    shift
    awk -v RS="${1:-:}" -v ORS='\n' '{print}'
    exit 0;;
  /*)      pre="$1";;
  [0-9]*)  print+=",\$$1";;
  -f)      script="$2"; shift;;
  *)       params+="$1 ";;
  esac; shift
done # }}}
if [[ -z $script ]]; then
  echoe $verbose "awk $params '$pre{print \"${print#,}\"}'"
  eval awk $params "'$pre{print "${print#,}"}'"
else
  if [[ $script != /* ]]; then
    [[ ! -e $script ]] && script="$scriptPath/$script"
    [[ ! -e $script ]] && die "script file [$script] %err:%s" "not found"
  fi
  echoe $verbose "awk $params -f $script"
  eval awk $params -f $script
fi
