endpoint-term() { # {{{
  return 0
} # }}}
endpoint-ls() { # {{{
  ls -1ap --group-directories-first $aDir 2>/dev/null
} # }}}
endpoint-find() { # {{{
  (cd "$aDir" && fd 2>/dev/null)
} # }}}
endpoint-cat() { # {{{
  cat "$1"
} # }}}
endpoint-vim-list() { # {{{
  (( $# == 3 )) && local dst="$1" aDir="$2" && shift 2
  local f="$1"
  [[ $f == /* ]] || f="${aDir%/}/$f"
  printf "%q" "$f"
} # }}}
endpoint-cp() { # {{{
  local -a sources=() f=
  for f in "${selected[@]}"; do
    [[ $f == /* ]] || f="${aDir%/}/$f"
    sources+=("$f")
  done
  cp -r "${sources[@]}" ./
} # }}}
endpoint-home-dir() { # {{{
  echo "$HOME"
} # }}}
