#!/usr/bin/env bash
# vim: fdl=0

if [[ $1 == "@@" ]]; then # @@:new # {{{
  exit 0
fi # }}}

TARGET_SUBNETS="HOME HOME_WORK"

get_interfaces() { # {{{
  if $IS_MAC; then
    ifconfig -l
  else
    find /sys/class/net -mindepth 1 -maxdepth 1 -printf '%P ' 2>/dev/null
  fi
} # }}}
get_iface_ip() { # {{{
  local ifa="$1"
  if $IS_MAC; then
    ifconfig "$ifa" 2>/dev/null | awk '$1 == "inet" {print $2; exit}'
  else
    ip -4 -brief addr show dev "$ifa" 2>/dev/null | awk '{split($3, a, "/"); print a[1]}'
  fi
} # }}}
get_default_gw() { # {{{
  local ifa="$1"
  if $IS_MAC; then
    route -n get default 2>/dev/null | awk -v ifa="$ifa" '$1 == "gateway:" {gw=$2} $1 == "interface:" && $2 == ifa {print gw}'
  else
    ip route show dev "$ifa" default 2>/dev/null | awk '$1 == "default" {print $3; exit}'
  fi
} # }}}
get_gw_mac() { # {{{
  local ifa="$1" gwAddr="$2" mac=
  if $IS_MAC; then
    mac="$(arp -i "$ifa" -n "$gwAddr" 2>/dev/null | awk 'NR = 1 {print $4; exit}')"
  else
    mac="$(arp -i "$ifa" -n "$gwAddr" 2>/dev/null | awk 'NR > 1 {print $3; exit}')"
  fi
  echo "${mac,,}"
} # }}}

for ifa in ${NET_IS_HOME_IFACES:-$(get_interfaces)}; do # {{{
  [[ "$ifa" == "lo"* ]] && continue
  ip_addr="$(get_iface_ip "$ifa")"
  [[ -n "$ip_addr" ]] || continue
  netFound=
  for net in $TARGET_SUBNETS; do # {{{
    declare -n netAddr="NET_${net}"
    [[ -n $netAddr && $ip_addr == $netAddr.* ]] && netFound=$net && break
  done # }}}
  [[ -n $netFound ]] || continue
  gw_ip="$(get_default_gw "$ifa")"
  [[ -n "$gw_ip" ]] || continue
  ping -c 1 -W 1 "$gw_ip" &>/dev/null || continue
  gw_mac="$(get_gw_mac "$ifa" "$gw_ip")"
  [[ -n $gw_mac ]] || continue
  declare -n gw_mac_expected="NET_${netFound}_GW_MAC"
  [[ "$gw_mac" == "${gw_mac_expected,,}" ]] && exit 0
done # }}}
exit 1
