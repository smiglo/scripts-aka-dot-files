python
import os
import re
import sys

confDir = os.path.expanduser("~/.config/gdb")
toUse = "dashboard"

if "pwndbg" in sys.modules and hasattr(sys.modules["pwndbg"], "_is_loaded_from_pwndbg"):
    # already loaded via pwndbg exec
    toUse = "pwndbg"
elif os.environ.get("GDB_USE_PWNDBG") == "true" or os.environ.get("GDB_PWNDBG_INIT"):
    toUse = "pwndbg"

if toUse == "pwndbg":
    pwnDbgConf = os.environ.get("GDB_PWNDBG_INIT")
    if not pwnDbgConf:
        pwnDbgConf = "/usr/share/pwndbg/gdbinit.py"
    if not os.path.exists(pwnDbgConf):
        toUse = "dashbard"

if toUse == "dashboard" and os.environ.get("GDB_USE_DASHBOARD") == "false":
    toUse = ""

for file in sorted(os.listdir(os.path.expanduser(confDir))):
    path = os.path.join(confDir, file)
    _, ext = os.path.splitext(path)
    _, filename = os.path.split(path)
    if ( ext == '.py' or ext == '.gdb') and (re.match('.*\\.ign.*', filename) is None):
        if re.match('.*dashboard.*', filename) and toUse != "dashboard":
            continue
        if re.match('.*pwndbg.*', filename) and toUse != "pwndbg":
            continue
        print(path)
        gdb.execute('source ' + path)

root = os.path.abspath('.')
if confDir != root:
  for file in sorted(os.listdir(os.path.expanduser(root))):
      path = os.path.join(root, file)
      _, ext = os.path.splitext(path)
      _, filename = os.path.split(path)
      if filename in ['.gdb', '.gdbinit', 'gdbinit']:
          print(path)
          gdb.execute('source ' + path)
end
